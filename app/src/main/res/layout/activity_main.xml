<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 顶栏：在线状态 + 当前地址 + 设置(⚙) + 重连(⟳)。
         这一栏是 WebView 上方的独立行，绝不浮在页面上，所以不会压住页面里的按钮。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:background="#F1EFE8">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="正在连接…"
            android:textColor="#5F5E5A"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/addrText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#8A8880"
            android:textSize="11sp" />

        <!-- ⚙ 家长设置（PIN 门控） -->
        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⚙"
            android:textColor="#0F6E56"
            android:textSize="20sp" />

        <!-- ⟳ 重新扫码连接（PIN 门控） -->
        <TextView
            android:id="@+id/btnReconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="⟳"
            android:textColor="#0F6E56"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 学生端页面本体，一行都不改 -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 连接面板：首次使用 / 从设置里点「换服务器」时展开（扫码 + 手输） -->
    <LinearLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="18dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView
            android:id="@+id/setupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="第一次使用"
            android:textColor="#2C2C2A"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="4dp"
            android:text="方式一：让手机扫电脑上的二维码\n方式二：手动把电脑地址打进去\n\n手机和电脑要连同一个 WiFi"
            android:textColor="#5F5E5A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/hostInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@android:drawable/editbox_background"
            android:hint="192.168.3.15:3000"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true"
            android:gravity="center_horizontal"
            android:textColor="#2C2C2A"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="手动输入"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/scanBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="扫 一 扫"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/cancelBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:text="取 消"
            android:textColor="#8A8880"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 家长设置面板：显示当前地址 + 换服务器 + 设置/修改父母 PIN（受 PIN 门控进入） -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="18dp"
        android:background="#FFFFFF"
        android:elevation="3dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="家长设置"
            android:textColor="#2C2C2A"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="当前连接"
            android:textColor="#8A8880"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/settingsAddr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#2C2C2A"
            android:textSize="15sp" />

        <Button
            android:id="@+id/changeServerBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:text="换服务器 / 重新扫码连接"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/forceRefreshBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_primary"
            android:text="强 制 刷 新"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="2dp"
            android:text="清掉本机缓存再重新加载页面\n（页面卡住、排版错乱或改了样式时用）"
            android:textColor="#8A8880"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E2E0D8" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="父母 PIN（锁定本设置、换服务器、重连）"
            android:textColor="#8A8880"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background"
            android:hint="输入 4–6 位 PIN"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#2C2C2A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/pinConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background"
            android:hint="再输一次确认"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#2C2C2A"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pinHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BA7517"
            android:textSize="12sp" />

        <Button
            android:id="@+id/savePinBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_primary"
            android:text="保存 PIN"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/settingsCloseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:text="关 闭"
            android:textColor="#8A8880"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
